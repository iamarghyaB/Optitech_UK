{
  "name": "optitech-uk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "build": "next build",
    "verify": "node scripts/verify.mjs",
    "prestart": "node scripts/check-assets.mjs",
    "preverify": "node scripts/check-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:restore": "git lfs checkout && node scripts/check-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "predev": "node scripts/check-assets.mjs",
    "prebuild": "node scripts/check-assets.mjs && node scripts/build-services.mjs && node scripts/prepare-vercel-assets.mjs",
    "build:reference": "node scripts/build.mjs && node scripts/build-agency-content.mjs && node scripts/build-services.mjs",
    "test:migration": "node scripts/test-next.mjs",
    "content:build": "node scripts/build.mjs && node scripts/build-agency-content.mjs && node scripts/build-services.mjs",
    "test:services": "node scripts/test-services.mjs",
    "test:home-preservation": "node scripts/test-home-preservation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
