# Production: an HTTPS CRM/form endpoint that durably accepts JSON enquiries.
# Endpoint should honour the Idempotency-Key header on retries.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
# Optional for a local production preview; never enabled on Vercel.
# ENQUIRY_TRANSPORT=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ENQUIRY_WEBHOOK_URL uses the enquiry-intake Edge Function URL.
# ENQUIRY_WEBHOOK_TOKEN is a server-only integration token (never NEXT_PUBLIC).
